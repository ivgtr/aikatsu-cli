{
  "name": "aikatsu-cli",
  "description": "アイカツ！格言を再生するCLI",
  "keywords": [
    "aikatsu",
    "kakugen",
    "cli"
  ],
  "version": "1.2.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aikatsu": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "ivgtr",
    "email": "ivgtr.me@gmail.com",
    "url": "https://github.com/ivgtr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivgtr/aikatsu-cli.git"
  },
  "homepage": "https://github.com/ivgtr/aikatsu-cli#readme",
  "bugs": {
    "url": "https://github.com/ivgtr/aikatsu-cli/issues"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/cli.ts",
    "src/configs/kakugen.js"
  ],
  "scripts": {
    "start": "tsc -w",
    "type-check": "tsc --noEmit",
    "type-build": "tsc --project ./tsconfig-build.json --emitDeclarationOnly",
    "prebuild": "node -e 'fs.rmSync(`dist`, {recursive:true, force:true})'",
    "build": "rollup -c && npm run type-build",
    "format": "prettier -w ./src/*",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@rollup/plugin-babel": "5.3.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "4.1.0",
    "@rollup/plugin-node-resolve": "13.3.0",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/jest": "29.5.14",
    "@types/node": "16.11.6",
    "@types/update-notifier": "6.0.9",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.4.1",
    "rollup": "2.80.0",
    "rollup-plugin-auto-external": "2.0.0",
    "rollup-plugin-preserve-shebang": "1.0.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tslib": "2.9.1",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "meow": "10.1.1",
    "symphogear-g": "^0.4.2",
    "update-notifier": "7.3.1"
  },
  "jest": {
    "globals": {
      "ts-jest": {
        "useESM": true
      }
    },
    "preset": "ts-jest/presets/js-with-ts-esm",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
