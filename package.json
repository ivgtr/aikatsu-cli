{
  "name": "aikatsu-cli",
  "description": "アイカツ！格言を再生するCLI",
  "keywords": [
    "aikatsu",
    "kakugen",
    "cli"
  ],
  "version": "1.2.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aikatsu": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "ivgtr",
    "email": "ivgtr.me@gmail.com",
    "url": "https://github.com/ivgtr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivgtr/aikatsu-cli.git"
  },
  "homepage": "https://github.com/ivgtr/aikatsu-cli#readme",
  "bugs": {
    "url": "https://github.com/ivgtr/aikatsu-cli/issues"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/cli.ts",
    "src/configs/kakugen.js"
  ],
  "scripts": {
    "start": "tsc -w",
    "type-check": "tsc --noEmit",
    "type-build": "tsc --project ./tsconfig-build.json --emitDeclarationOnly",
    "prebuild": "node -e 'fs.rmSync(`dist`, {recursive:true, force:true})'",
    "build": "node build.mjs && npm run type-build",
    "format": "prettier -w ./src/*",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/update-notifier": "6.0.9",
    "esbuild": "^0.25.0",
    "prettier": "2.4.1",
    "tsx": "^4.20.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "meow": "10.1.1",
    "symphogear-g": "^0.4.2",
    "update-notifier": "7.3.1"
  }
}
